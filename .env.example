# ==============================================================================
# ServiceDesk Environment Variables Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit real credentials or .env files to source control.
# ==============================================================================

# Database name for local PostgreSQL instance (Docker Compose)
POSTGRES_DB=servicedesk

# Database user for local PostgreSQL instance
POSTGRES_USER=servicedesk_user

# Database password for local PostgreSQL instance (change in production)
POSTGRES_PASSWORD=servicedesk_dev_password

# Port mapped to local PostgreSQL host (default: 5432)
POSTGRES_PORT=5432

# Active Spring profile: 'local' (Docker Compose / local DB) or 'cloud' (Supabase direct session connection)
SPRING_PROFILES_ACTIVE=local

# JDBC connection URL used by Spring Boot backend
# Local default: jdbc:postgresql://postgres:5432/servicedesk (or localhost:5432 if running outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/servicedesk

# Spring datasource username matching PostgreSQL credentials
SPRING_DATASOURCE_USERNAME=servicedesk_user

# Spring datasource password matching PostgreSQL credentials
SPRING_DATASOURCE_PASSWORD=servicedesk_dev_password

# REQUIRED. Private key for signing login tokens (32+ characters). The app refuses to start with
# the placeholder below. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_at_least_32_bytes_long

# Seeded demo accounts (emp, tech_net, tech_hw, tech_lead, admin) share a documented password.
# They are deactivated on startup unless this is true. Only enable for local demos.
DEMO_ACCOUNTS_ENABLED=false

# Root superuser, created on first start only when no root account exists (12+ characters).
ROOT_USERNAME=root
ROOT_PASSWORD=

# Google sign-in: OAuth 2.0 "Web application" client id from Google Cloud Console.
# Add http://localhost:3000 to its Authorized JavaScript origins. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
# Optional: only allow these Google Workspace domains (comma-separated), e.g. example.edu
GOOGLE_ALLOWED_DOMAINS=

# Assistant: a Google AI Studio API key turns on Gemini for triage, self-help, fix suggestions and
# summaries. Leave empty to use the built-in rules (every feature still works). Never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email through Brevo (transactional API). Leave the key empty to only log emails.
# MAIL_FROM_ADDRESS must be a sender verified in your Brevo account.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ServiceDesk
# Public address of the web app, used for links in emails.
APP_BASE_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins for backend API access
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL for Spring Boot REST API consumed by Next.js frontend client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
