classDiagram
    direction TB

    %% ==========================================
    %% DOMAIN CORE ENTITIES & AGGREGATES
    %% ==========================================
    class Incident {
        -IncidentId id
        -String title
        -String description
        -Category category
        -Priority priority
        -Impact impact
        -Urgency urgency
        -UserId reporterId
        -UserId assigneeId
        -IncidentState currentState
        -SlaWindow slaWindow
        -EscalationLevel escalationLevel
        -IncidentId parentIncidentId
        -Instant respondedAt
        -Instant createdAt
        -Instant updatedAt
        +assign(UserId technicianId, UserId actorId)
        +acknowledge(UserId technicianId)
        +startWork(UserId technicianId)
        +requestInfo(String question, UserId technicianId)
        +provideInfo(String answer, UserId reporterId)
        +resolve(String resolutionSummary, UserId technicianId)
        +resolveWithParent(String resolutionSummary)
        +linkToParent(IncidentId parentId)
        +escalateTo(EscalationLevel level, Instant at)
        +isResponseOverdue(Instant now) boolean
        +close(UserId actorId)
        +cancel(String reason, UserId actorId)
        +evaluateSla(Clock clock)
        +getStatus() IncidentStatus
    }

    class IncidentId {
        -UUID value
        +of(UUID value) IncidentId
        +generate() IncidentId
        +getValue() UUID
    }

    class UserId {
        -UUID value
        +of(UUID value) UserId
        +getValue() UUID
    }

    class User {
        -UserId id
        -String username
        -String fullName
        -String email
        -Role role
        -Set~Category~ skills
        -int activeTicketsCount
        -int maxActiveTickets
        -boolean teamLead
        +isAvailable() boolean
        +hasSkill(Category category) boolean
        +hasCapacity() boolean
        +isTeamLead() boolean
    }

    class SlaWindow {
        -Instant responseDeadline
        -Instant resolutionDeadline
        -Duration pausedDuration
        -Instant pausedAt
        -SlaStatus status
        +pause(Instant now)
        +resume(Instant now)
        +checkBreach(Instant now) SlaStatus
    }

    class AuditLog {
        -UUID id
        -IncidentId incidentId
        -UserId actorId
        -String action
        -String oldValue
        -String newValue
        -Instant timestamp
        -String remarks
    }

    %% ==========================================
    %% PATTERN 1: STATE PATTERN (Incident Lifecycle)
    %% ==========================================
    class IncidentState {
        <<interface>>
        +assign(Incident context, UserId technicianId, UserId actorId)
        +acknowledge(Incident context, UserId technicianId)
        +startWork(Incident context, UserId technicianId)
        +requestInfo(Incident context, String question, UserId technicianId)
        +provideInfo(Incident context, String answer, UserId reporterId)
        +resolve(Incident context, String resolutionSummary, UserId technicianId)
        +resolveWithParent(Incident context, String resolutionSummary)
        +close(Incident context, UserId actorId)
        +cancel(Incident context, String reason, UserId actorId)
        +getStatus() IncidentStatus
    }

    class ReportedState {
        +assign(Incident context, UserId technicianId, UserId actorId)
        +cancel(Incident context, String reason, UserId actorId)
        +getStatus() IncidentStatus
    }
    class AssignedState {
        +acknowledge(Incident context, UserId technicianId)
        +startWork(Incident context, UserId technicianId)
        +assign(Incident context, UserId technicianId, UserId actorId)
        +cancel(Incident context, String reason, UserId actorId)
        +resolveWithParent(Incident context, String resolutionSummary)
        +getStatus() IncidentStatus
    }
    class AcknowledgedState {
        +startWork(Incident context, UserId technicianId)
        +assign(Incident context, UserId technicianId, UserId actorId)
        +cancel(Incident context, String reason, UserId actorId)
        +resolveWithParent(Incident context, String resolutionSummary)
        +getStatus() IncidentStatus
    }
    class InProgressState {
        +requestInfo(Incident context, String question, UserId technicianId)
        +resolve(Incident context, String resolutionSummary, UserId technicianId)
        +assign(Incident context, UserId technicianId, UserId actorId)
        +getStatus() IncidentStatus
    }
    class PendingInfoState {
        +provideInfo(Incident context, String answer, UserId reporterId)
        +getStatus() IncidentStatus
    }
    class ResolvedState {
        +close(Incident context, UserId actorId)
        +getStatus() IncidentStatus
    }
    class ClosedState {
        +getStatus() IncidentStatus
    }
    class CancelledState {
        +getStatus() IncidentStatus
    }

    IncidentState <|.. ReportedState
    IncidentState <|.. AssignedState
    IncidentState <|.. AcknowledgedState
    IncidentState <|.. InProgressState
    IncidentState <|.. PendingInfoState
    IncidentState <|.. ResolvedState
    IncidentState <|.. ClosedState
    IncidentState <|.. CancelledState
    Incident *-- IncidentState

    %% ==========================================
    %% PATTERN 2: STRATEGY PATTERNS
    %% ==========================================
    class AssignmentStrategy {
        <<interface>>
        +selectTechnician(Incident incident, List~User~ availableTechnicians) Optional~User~
    }
    class RoundRobinAssignmentStrategy {
        -AtomicInteger counter
        +selectTechnician(Incident incident, List~User~ availableTechnicians) Optional~User~
    }
    class LeastLoadedAssignmentStrategy {
        +selectTechnician(Incident incident, List~User~ availableTechnicians) Optional~User~
    }
    class SkillMatchAssignmentStrategy {
        -AssignmentStrategy fallbackStrategy
        +selectTechnician(Incident incident, List~User~ availableTechnicians) Optional~User~
    }

    AssignmentStrategy <|.. RoundRobinAssignmentStrategy
    AssignmentStrategy <|.. LeastLoadedAssignmentStrategy
    AssignmentStrategy <|.. SkillMatchAssignmentStrategy

    %% DECORATOR: capacity limits for any strategy
    class CapacityAwareAssignmentStrategy {
        -AssignmentStrategy delegate
        +selectTechnician(Incident incident, List~User~ availableTechnicians) Optional~User~
    }
    AssignmentStrategy <|.. CapacityAwareAssignmentStrategy
    CapacityAwareAssignmentStrategy o-- AssignmentStrategy : wraps

    %% ==========================================
    %% CHAIN OF RESPONSIBILITY: Escalation
    %% ==========================================
    class EscalationHandler {
        <<abstract>>
        -EscalationHandler next
        +linkWith(EscalationHandler next) EscalationHandler
        +handle(Incident incident, Instant now) Optional~EscalationDecision~
        #level() EscalationLevel
        #applies(Incident incident, Instant now) boolean
        #reason(Incident incident) String
    }
    class TeamLeadEscalationHandler
    class AdministratorEscalationHandler
    class ItManagerEscalationHandler
    class EscalationChain {
        +standard()$ EscalationHandler
    }
    class EscalationDecision {
        <<record>>
        +EscalationLevel level
        +String reason
    }
    class EscalationLevel {
        <<enumeration>>
        NONE
        TEAM_LEAD
        ADMINISTRATOR
        IT_MANAGER
    }
    EscalationHandler <|-- TeamLeadEscalationHandler
    EscalationHandler <|-- AdministratorEscalationHandler
    EscalationHandler <|-- ItManagerEscalationHandler
    EscalationHandler --> EscalationHandler : next
    EscalationChain ..> EscalationHandler : builds
    EscalationHandler ..> EscalationDecision : returns
    Incident --> EscalationLevel

    class SlaScheduledEvaluator {
        -EscalationHandler escalationChain
        -AssignmentStrategy reassignment
        +evaluateAllSla()
    }
    SlaScheduledEvaluator --> EscalationHandler
    SlaScheduledEvaluator --> CapacityAwareAssignmentStrategy

    class PriorityCalculationStrategy {
        <<interface>>
        +calculatePriority(Impact impact, Urgency urgency) Priority
    }
    class MatrixPriorityStrategy {
        +calculatePriority(Impact impact, Urgency urgency) Priority
    }
    PriorityCalculationStrategy <|.. MatrixPriorityStrategy

    class SimilarityStrategy {
        <<interface>>
        +calculateSimilarity(String textA, String textB) double
    }
    class JaccardSimilarityStrategy {
        +calculateSimilarity(String textA, String textB) double
    }
    SimilarityStrategy <|.. JaccardSimilarityStrategy

    %% ==========================================
    %% PATTERN 3: OBSERVER PATTERN (Events & Listeners)
    %% ==========================================
    class DomainEvent {
        <<interface>>
        +occurredOn() Instant
    }
    class IncidentCreatedEvent {
        -IncidentId incidentId
        -UserId reporterId
        -Priority priority
        -Instant timestamp
    }
    class IncidentStatusChangedEvent {
        -IncidentId incidentId
        -IncidentStatus oldStatus
        -IncidentStatus newStatus
        -UserId actorId
        -Instant timestamp
    }
    class SlaBreachedEvent {
        -IncidentId incidentId
        -Priority priority
        -Instant timestamp
    }

    DomainEvent <|.. IncidentCreatedEvent
    DomainEvent <|.. IncidentStatusChangedEvent
    DomainEvent <|.. SlaBreachedEvent

    class DomainEventPublisher {
        <<interface>>
        +publish(DomainEvent event)
        +subscribe(DomainEventListener listener)
    }

    class DomainEventListener {
        <<interface>>
        +onEvent(DomainEvent event)
    }

    class AuditLogEventListener {
        -AuditLogRepository auditLogRepo
        +onEvent(DomainEvent event)
    }
    class NotificationEventListener {
        -List~NotificationChannel~ channels
        +onEvent(DomainEvent event)
    }

    DomainEventListener <|.. AuditLogEventListener
    DomainEventListener <|.. NotificationEventListener
    DomainEventPublisher o-- DomainEventListener

    %% ==========================================
    %% PATTERN 4: FACTORY PATTERN
    %% ==========================================
    class IncidentFactory {
        -PriorityCalculationStrategy priorityStrategy
        -Clock clock
        +createIncident(String title, String desc, Category cat, Impact imp, Urgency urg, UserId reporter) Incident
    }
    IncidentFactory ..> Incident : creates

    %% ==========================================
    %% PATTERN 5: REPOSITORY & ADAPTER (HEXAGONAL / PORTS & ADAPTERS)
    %% ==========================================
    class IncidentRepository {
        <<interface>>
        +findById(IncidentId id) Optional~Incident~
        +save(Incident incident) Incident
        +findWithFilters(IncidentFilter filter) List~Incident~
    }
    class JpaIncidentRepositoryAdapter {
        -SpringDataIncidentJpaRepository jpaRepo
        +findById(IncidentId id) Optional~Incident~
        +save(Incident incident) Incident
        +findWithFilters(IncidentFilter filter) List~Incident~
    }
    IncidentRepository <|.. JpaIncidentRepositoryAdapter

    class NotificationChannel {
        <<interface>>
        +send(NotificationMessage message)
    }
    class InAppNotificationChannel {
        -NotificationDataRepository notificationRepo
        +send(NotificationMessage message)
    }
    class EmailGatewayAdapter {
        -EmailService emailService
        +send(NotificationMessage message)
    }
    class BrevoEmailChannelAdapter {
        -RestClient http
        -String apiKey
        +send(NotificationMessage message)
    }
    class LiveNotificationChannelAdapter {
        -LiveEventBroadcaster broadcaster
        +send(NotificationMessage message)
    }
    NotificationChannel <|.. InAppNotificationChannel
    NotificationChannel <|.. EmailGatewayAdapter
    NotificationChannel <|.. BrevoEmailChannelAdapter
    NotificationChannel <|.. LiveNotificationChannelAdapter

    %% OBSERVER over Server-Sent Events: each open stream is a subscriber
    class LiveEventBroadcaster {
        -Map streams
        +subscribe(UUID userId) SseEmitter
        +send(UUID userId, String event, Object data)
    }
    LiveNotificationChannelAdapter --> LiveEventBroadcaster

    %% ADAPTER: help desk assistant
    class IncidentAssistant {
        <<interface>>
        +source() String
        +triage(TicketDraft draft, List~String~ serviceNames) TriageSuggestion
        +selfHelp(TicketDraft draft, List~PastFix~ pastFixes) AssistantAdvice
        +suggestFix(TicketContext ticket, List~PastFix~ similarResolved) AssistantAdvice
        +summarize(TicketContext ticket) String
    }
    class GeminiAssistantAdapter {
        -RestClient http
        -String model
        +isEnabled() boolean
    }
    class RuleBasedIncidentAssistant
    class AssistantApplicationService {
        -GeminiAssistantAdapter gemini
        -IncidentAssistant rules
    }
    IncidentAssistant <|.. GeminiAssistantAdapter
    IncidentAssistant <|.. RuleBasedIncidentAssistant
    AssistantApplicationService --> IncidentAssistant : Gemini first, rules on failure

    class KnowledgeBase {
        <<utility>>
        +articles() List~Article~
        +best(text) Optional~Article~
        +search(text, limit) List~Article~
    }
    class AiAdviceCacheEntity {
        -String cacheKey
        -String kind
        -String summary
        -String steps
        -boolean itRelated
    }
    class CategoryApplicationService {
        +list() List~CategorySettingResponse~
        +update(category, active)
    }
    RuleBasedIncidentAssistant --> KnowledgeBase : on-device answers
    GeminiAssistantAdapter --> KnowledgeBase : grounding notes for chat
    AssistantApplicationService --> AiAdviceCacheEntity : saves Gemini answers
    class IncidentAffectedEntity {
        -UUID incidentId
        -UUID userId
    }
    IncidentApplicationService --> IncidentAffectedEntity : "affects me too"
    IncidentApplicationService --> CategoryApplicationService : category switch

    %% Relationships
    Incident *-- IncidentId
    Incident *-- SlaWindow
    Incident --> UserId : reporter & assignee
    User *-- UserId
    Incident --> Incident : parent (major incident)

    class UpdateKind {
        <<enumeration>>
        COMMENT
        QUESTION
        ANSWER
        PICKUP
        RESOLUTION
        STATUS
    }
    AuditLog --> IncidentId
    AuditLog --> UserId
